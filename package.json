{
  "name": "missionapp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=11.5.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "openapi:sync": "node scripts/sync-openapi.mjs",
    "openapi:generate": "kubb generate",
    "openapi:build": "pnpm openapi:sync && pnpm openapi:generate"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "axios": "^1.16.1",
    "next": "^16.2.6",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.76.0",
    "react-international-phone": "^4.8.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "21.2.2",
    "@commitlint/types": "21.2.0",
    "@kubb/plugin-axios": "5.0.0",
    "@kubb/plugin-ts": "5.0.0",
    "@kubb/plugin-zod": "5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "commitlint": "21.2.2",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.3.1",
    "husky": "9.1.7",
    "kubb": "5.0.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4",
    "typescript": "^5"
