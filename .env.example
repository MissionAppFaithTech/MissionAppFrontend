# URL pública do front (SEO / links canônicos)
# Sem domínio ainda: use localhost. Em produção na Vercel, o código usa VERCEL_URL se vazio.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API AdonisJS (server-side / BFF). Porta padrão do backend: 3333
# Não precisa do sufixo /api/v1 — o BFF adiciona.
API_URL=http://localhost:3333

# Segredo compartilhado com a API para os rate limits usarem o IP real do usuário
# (MissionAppBackend ADR-0032). Mesmo valor de BFF_SHARED_SECRET na API. Opcional; nunca NEXT_PUBLIC_.
# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# BFF_SHARED_SECRET=

# Opcional: fallback legado (mesmo valor de API_URL). Preferir API_URL.
# NEXT_PUBLIC_API_URL=http://localhost:3333
